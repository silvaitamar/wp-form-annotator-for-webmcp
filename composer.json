{
	"name": "silvaitamar/form-annotator-for-webmcp",
	"description": "Annotate WordPress forms with declarative WebMCP attributes for browser AI agents.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Itamar Silva",
			"homepage": "https://github.com/silvaitamar"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Siwmfa\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.0"
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "php tests/test-core.php",
		"i18n": "wp i18n make-pot . languages/silvaitamar-form-annotator-for-webmcp.pot --domain=silvaitamar-form-annotator-for-webmcp --slug=silvaitamar-form-annotator-for-webmcp --exclude=vendor,node_modules,scripts,tests,.wordpress-org,docs"
	}
}
